# Server Configuration
PORT=3000
DATABASE_PATH=/data/fitness.db
NODE_ENV=production

# Pocket-ID OIDC Configuration
# URL of your Pocket-ID instance (e.g. https://auth.yourdomain.com)
POCKET_ID_URL=http://pocket-id:80
# Client ID registered in Pocket-ID
POCKET_ID_CLIENT_ID=brizfit-tracker
# Audience or realm if applicable
POCKET_ID_AUDIENCE=brizfit-tracker

# Frontend Vite variables (passed at build time or injected)
VITE_POCKET_ID_URL=http://localhost:8080
VITE_CLIENT_ID=brizfit-tracker
